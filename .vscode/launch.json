{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Website: server and browser",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "--port", "3100", "--hostname", "127.0.0.1"],
      "runtimeArgs": ["--inspect"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true,
      "preLaunchTask": "Docs: build",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:\\s+(https?://[^\\s]+)",
        "uriFormat": "%s/en/harness/",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      "name": "Website: browser (existing server)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:3100/en/harness/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Docs: browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173/docs/en/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Dev: docs"
    }
  ]
}
